# Copy to .env.
#
# Local development — a plain SQLite file on disk. No account, no signup.
# The file is created automatically by `yarn db:schema` and is gitignored.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Production (set these in Vercel, not here). Vercel's filesystem is ephemeral,
# so a file: database cannot be written to there — it needs a hosted one.
# Create a database at https://app.turso.tech, then copy its URL and a token:
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-token
