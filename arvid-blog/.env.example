# Copy to .env for local development with `vercel dev`.
# In production these are set in Vercel under Settings → Environment Variables.
#
# Get both values from the Turso CLI:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>

TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=
