# Copy to .env for local development. In production these are set in Vercel
# under Settings → Environment Variables.
#
# Both values come from the Turso dashboard at https://app.turso.tech —
# create a database, then read the URL from its overview page and generate a
# token there. (The Turso CLI is an alternative, but it requires WSL on
# Windows, so the dashboard is the simpler route.)

TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=
